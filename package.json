{
  "name": "altbieratlas",
  "version": "0.3.6",
  "description": "Die interaktive Karte des Altbiers — Cloudflare Workers + D1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:create": "wrangler d1 create ${D1_DATABASE_NAME:-altbieratlas}",
    "db:setup": "bash scripts/db-setup.sh",
    "db:setup:remote": "bash scripts/db-setup.sh --remote",
    "db:setup:demo": "bash scripts/db-setup.sh --demo",
    "db:setup:demo:remote": "bash scripts/db-setup.sh --remote --demo",
    "admin:create": "node scripts/create-admin.mjs"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
